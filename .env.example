# OpenAI (required for synthesis)
OPENAI_API_KEY=sk-your-openai-key-here

# Serper.dev (required for web search)
SERPER_API_KEY=your-serper-key-here

# Jina AI (required for content extraction)
JINA_API_KEY=jina_your-jina-key-here

# Apollo.io (optional — lead enrichment)
APOLLO_API_KEY=your-apollo-key-here

# Pipeline defaults (optional — these have sensible defaults)
# MAX_SEARCH_QUERIES=3
# MAX_JINA_EXTRACTIONS=5
# OPENAI_MODEL=gpt-4.1-mini
# DEBUG=false
